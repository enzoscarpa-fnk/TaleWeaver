generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  Session[]
  conversations Conversation[]
  usageStats UsageStats[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  gameSession GameSession?

  @@index([userId])
}

model Message {
  id        String       @id @default(cuid())
  sessionId String
  session   Conversation @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  model     String

  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  totalTokens      Int   @default(0)
  promptCost       Float @default(0)
  completionCost   Float @default(0)
  totalCost        Float @default(0)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model UsageStats {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  model         String
  totalRequests Int      @default(0)
  totalTokens   Int      @default(0)
  totalCost     Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, model])
  @@index([userId, date])
}

model Character {
  id         String @id @default(cuid())
  name       String
  class      String
  level      Int    @default(1)
  experience Int    @default(0)

  health       Int @default(100)
  maxHealth    Int @default(100)
  mana         Int @default(50)
  maxMana      Int @default(50)
  strength     Int @default(10)
  intelligence Int @default(10)
  agility      Int @default(10)

  backstory String?
  avatar    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameSessions GameSession[]
}

model Memory {
  id        String   @id @default(uuid())
  sessionId String // Lié à la conversation
  type      String // NARRATIVE, NPC_INTERACTION, PLAYER_ACTION
  content   String // Description textuelle de l'événement
  embedding String // JSON stringifié du vecteur
  timestamp DateTime @default(now())
  metadata  String? // JSON optionnel {npcId?, location?, questId?}

  @@index([sessionId])
  @@index([timestamp])
}

model GameSession {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id])

  // États du jeu
  currentLocation String @default("Port de Tortuga")
  gold            Int    @default(100)
  reputation      Int    @default(0)

  // Combat actif ?
  combat Combat?

  // Quêtes
  quests Quest[]

  // Inventaire
  inventory InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([characterId])
}

model Combat {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  isActive    Boolean @default(true)
  currentTurn Int     @default(1)

  // Stats du joueur pendant le combat
  playerHP      Int
  playerMaxHP   Int
  playerMana    Int
  playerMaxMana Int

  // Ennemis (stockés en JSON)
  enemies String // JSON: [{id, name, hp, maxHp, attack, defense}]

  // Log du combat
  combatLog String @default("[]") // JSON array

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quest {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questId     String // ID unique de la quête (ex: "rescue_merchant")
  name        String
  description String
  status      QuestStatus @default(ACTIVE)

  // Objectifs (JSON)
  objectives String // JSON: [{id, description, completed: boolean}]

  // Récompenses
  goldReward Int @default(0)
  xpReward   Int @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([sessionId])
  @@index([status])
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
}

model InventoryItem {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  itemId   String // ID unique de l'item (ex: "health_potion")
  name     String
  type     ItemType
  quantity Int      @default(1)

  // Propriétés de l'item (JSON)
  properties String // JSON: {damage?, healing?, defense?, etc.}

  equippedAt DateTime? // null = dans l'inventaire, date = équipé

  @@index([sessionId])
}

enum ItemType {
  WEAPON
  ARMOR
  CONSUMABLE
  QUEST_ITEM
  MISC
}
